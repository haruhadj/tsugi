# Tsugi — environment contract
#
# Copy this file to `.env` and fill in the values there.
# `.env` is gitignored. This file must NEVER contain a real value.
#
# The phase tag on each variable says when it starts being read. A blank value
# for a later-phase variable is expected, not a mistake.


# ── Phase 1 — database ────────────────────────────────────────────────────────
# Supabase dashboard → Connect → ORMs / Drizzle, or Project Settings → Database.
#
# DATABASE_URL is the TRANSACTION POOLER on port 6543. The application uses this.
# It is IPv4-compatible, so it works from anywhere including Vercel.
# The driver MUST be constructed with { prepare: false } — the transaction pooler
# does not support prepared statements. See context/tech-stack.md (D8).
#
# Do NOT append ?pgbouncer=true. That is a Prisma convention. postgres.js has no
# such option and may forward it to the server as an unrecognised connection
# parameter. Prepared statements are disabled in code, not in the URL.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:6543/postgres"

# DIRECT_URL is used only by drizzle-kit, for migrations. Two options work:
#
#   SESSION POOLER (recommended)  same pooler host, port 5432 — IPv4-compatible,
#                                 so it also works from CI runners.
#   DIRECT CONNECTION             db.<project-ref>.supabase.co:5432 — IPv6-only
#                                 without Supabase's IPv4 add-on.
#
# Session mode holds a dedicated connection for the session, so it supports the
# prepared statements and session-level features migrations need.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:5432/postgres"


# ── Phase 6 — public base URL ─────────────────────────────────────────────────
# Absolute base for og:image. Social crawlers reject relative URLs, and this must
# not be derived from request headers because we do not control a crawler's Host.
# Falls back to VERCEL_URL, then http://localhost:3000.
NEXT_PUBLIC_APP_URL=""


# ── Phase 4 — rate limiting ───────────────────────────────────────────────────
# Optional in development: without these, an in-memory limiter is used and logs
# that it did so. REQUIRED in production — serverless instances share no memory,
# so an in-memory limiter there is no limiter at all. See D9.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""


# ── Phase 2 — authentication ─────────────────────────────────────────────────
# Two OAuth apps. AniList and MAL both unlock list import (Phase 7).
# Secret: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# anilist.co/settings/developer
ANILIST_CLIENT_ID=""
ANILIST_CLIENT_SECRET=""

# myanimelist.net/apiconfig
# NOTE: MAL PKCE supports code_challenge_method=plain ONLY (see D30).
# MAL_CLIENT_ID is also sent as the X-MAL-CLIENT-ID header on every API v2 call.
MAL_CLIENT_ID=""
MAL_CLIENT_SECRET=""


